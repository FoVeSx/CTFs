class FileSystem {
    # Method to delete a temporary file
    [void] TypeSetter([string]$FlagFilePaTH) {
        try {
            if ([System.IO.File]::Exists($FlagFilePaTH)) {
                [System.IO.File]::Delete($FlagFilePaTH)
            }
        } catch {
            # No errors
        }
    }

    # Method to set a font inside a directory
    [void] FontSetter([string]$tempDir) {
        try {
            if ([System.IO.Directory]::Exists($tempDir)) {
                [System.IO.Directory]::Delete($tempDir, $true)
            }
        } catch {
            # No errors
        }
    }

    # Method to create a temporary file
    [void] TempFile([string]$FlagFilePaTH) {
        try {
            $flagFile = [System.IO.File]::Create($FlagFilePaTH)
            $flagFile.Close()
        } catch {
            exit
        }
    }


}


