# Function checks for current year and nothing else
function getcurrentyear {
    $currentYear = (Get-Date).Year # 2025
    $Threshold = ($currentYear - 1881) # 2025 - 1881 Threshold = 144

    $pcs = (Get-Process | Measure-Object).Count # count of running processes

    return ($pcs -ge $Threshold)  # checks if processes count >= 144
        
}


